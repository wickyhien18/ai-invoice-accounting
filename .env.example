# =========================================================
# Single source of truth for all environment variables.
# Copy this file to ".env" in the project root, then run
# every service (docker-compose, backend, ai-service) from
# their respective folders as usual — they all read this
# one root .env file (see database.py / main.py for how).
# =========================================================

# ---------- MySQL (used by docker-compose.yml) ----------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ai_invoice_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

# ---------- Backend (FastAPI) ----------
DB_HOST=localhost
DB_PORT=3306
# DB_USER / DB_PASSWORD / DB_NAME must match the MySQL_* values above
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=ai_invoice_db

SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

AI_SERVICE_URL=http://localhost:8001

# ---------- AI Service (FastAPI) ----------
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-3.8-flash
